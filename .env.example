# ── Model endpoint (any OpenAI-compatible API) ──────────────────
# OpenAI:        https://api.openai.com/v1
# OpenRouter:    https://openrouter.ai/api/v1
# Ollama:        http://localhost:11434/v1
# vLLM on HPC:   https://<your-host>/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-no-key
MODEL=gpt-4o-mini

# ── Server ───────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8321

# ── Branding ─────────────────────────────────────────────────────
TITLE=muji
BRAND=muji
CREATOR=Jan (jblagana) — AI student at UP Diliman, Teaching Associate in EEEI   # who the agent says it was created by (identity prompt)

# ── Agent ────────────────────────────────────────────────────────
# Folder the agent treats as "home" for relative paths. Set it to
# wherever you want it to work (your projects folder, your home dir…).
# Empty = your OS home directory (recommended).
ROOT_DIR=
FACT_CHECK=0
TOOL_MODE=auto
# 0 = unlimited tool turns (context compaction paces the run instead).
# Set a number for a hard safety cap.
MAX_TURNS=0
TEMPERATURE=0.7
# Model thinking control (Qwen3-style endpoints; others may ignore it):
#   low | medium | xhigh  → reasoning_effort tier (server default is often
#                           xhigh — the main source of "overthinking"),
#   off                   → no chain-of-thought at all,
#   (omit)                → server default.
THINKING=low
# Context compaction: when the estimated context (chars/4) reaches
# COMPACT_TRIGGER, the older messages are summarized into one message.
# Keep the trigger well below the model's real limit (headroom for the
# summary call + next message + next tool output).
COMPACT_ENABLED=1
COMPACT_CONTEXT_LIMIT=200000
COMPACT_TRIGGER=160000
COMPACT_RECENT=4
COMMAND_TIMEOUT=120
APPROVAL_TIMEOUT=180
# How many chats may run their agent at the same time (multi-instance mode):
MAX_PARALLEL_AGENTS=4

# ── Tool opt-in / opt-out ────────────────────────────────────────
# Comma-separated tool NAMES to EXCLUDE from this install. Empty = ship
# the full default set. Removing a tool drops it from the model's schema,
# the prompt, and blocks any call to it (even if a text-protocol model
# still names it).
#
#   Core (the bare harness — keep these unless you know why you'd cut them):
#     list_dir read_file write_file edit_file search_files run_command
#     web_search fetch_url browser verify_math ask_user
#     local_search index_documents        (local RAG over your own docs)
#
#   Personal integrations (opt-IN — disabled by default below; enable a
#   group by removing its tools from TOOLS_DISABLED AND adding its creds):
#     gmail_search gmail_read             → needs a Gmail OAuth setup
#     tg_search tg_read                   → needs a Telegram session
#     tasks_list tasks_add tasks_done     → local to-do store
#     events_add events_list events_done  → local calendar store
#
# Default below: the personal groups are OFF, the core is ON. Tweak freely.
TOOLS_DISABLED=gmail_search,gmail_read,tg_search,tg_read,tasks_list,tasks_add,tasks_done,events_add,events_list,events_done
